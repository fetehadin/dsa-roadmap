---
import Base from '@/layouts/Base.astro';
import Roadmap from '@/components/Roadmap.astro';
import { allTopics } from '@/lib/catalog';
import { phases, CORE_RULE } from '@/data/chapters';

const core = (await allTopics()).filter((t) => t.data.chapter !== 'levelup');
---

<Base title="DSA Roadmap">
  <section class="pt-12 pb-8 sm:pt-20">
    <p class="eyebrow">Free · self-paced · C++</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-[1.05] font-bold text-balance sm:text-6xl">
      Data Structures &amp; Algorithms in C++
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      Learn the structures and algorithms every programmer relies on by watching them run step by
      step, reading real C++, and practising until you can write them yourself.
    </p>
    <p class="mt-6 flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm text-faint">
      <span>{phases.length} phases</span>
      <span>{core.length} topics</span>
      <span>no sign-up</span>
    </p>
  </section>

  <section id="roadmap" class="scroll-mt-20" aria-label="Roadmap">
    <Roadmap />
  </section>

  <section class="mt-6 grid gap-3 sm:grid-cols-3">
    <a href="/level-up" class="card p-5 transition-colors hover:border-line-strong">
      <div class="font-display font-semibold">Level Up →</div>
      <p class="mt-1 text-sm text-muted">
        Optional problem patterns: two pointers, sliding window, monotonic stack.
      </p>
    </a>
    <a href="/exam" class="card p-5 transition-colors hover:border-line-strong">
      <div class="font-display font-semibold">Test yourself →</div>
      <p class="mt-1 text-sm text-muted">A random timed quiz across the phases you pick.</p>
    </a>
    <a href="/guide" class="card p-5 transition-colors hover:border-line-strong">
      <div class="font-display font-semibold">How to use this →</div>
      <p class="mt-1 text-sm text-muted">{CORE_RULE}</p>
    </a>
  </section>
</Base>
