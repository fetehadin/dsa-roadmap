---
import Base from '@/layouts/Base.astro';
import ChapterGrid from '@/components/ChapterGrid.astro';
import { CORE_RULE } from '@/data/chapters';
---

<Base title="Learn" description="All 8 chapters of CoSc3111 in study order, grouped into three phases.">
  <div class="pt-8 sm:pt-12">
    <span class="eyebrow">Learn</span>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">The roadmap</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">Eight chapters, in the order of the official outline. Go in order; each chapter uses the one before it.</p>
    <p class="mt-4 inline-block rounded-xl border border-dashed border-line px-4 py-2.5 text-sm">💡 {CORE_RULE}</p>
    <div class="mt-8"><ChapterGrid /></div>
    <a href="/level-up" class="card mt-8 flex flex-wrap items-center justify-between gap-3 p-5 hover:border-line-strong">
      <span><span class="font-semibold">Level Up: problem patterns</span><span class="block text-sm text-muted">Two pointers, sliding window, prefix sum, fast & slow pointers, monotonic stack. Optional, not on the exam.</span></span>
      <span class="btn btn-sm">Explore →</span>
    </a>
  </div>
</Base>
