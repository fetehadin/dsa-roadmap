---
import Base from '@/layouts/Base.astro';
import TopicPage from '@/components/TopicPage.astro';
import ChapterPage from '@/components/ChapterPage.astro';
import { allTopics, type Topic } from '@/lib/catalog';
import { chapters, chapterById, type ChapterId } from '@/data/chapters';

export async function getStaticPaths() {
  const topics = await allTopics();
  return [
    ...chapters
      .filter((c) => c.id !== 'levelup')
      .map((c) => ({ params: { slug: c.slug }, props: { chapter: c.id } })),
    ...topics.map((t) => ({ params: { slug: t.id }, props: { topic: t } })),
  ];
}
const { topic, chapter } = Astro.props as { topic?: Topic; chapter?: ChapterId };
const ch = chapterById(topic ? topic.data.chapter : chapter!);
const ogKey = ch.slug;
---

<Base
  title={topic ? topic.data.title : `Phase ${Number(ch.num)}: ${ch.title}`}
  description={topic ? topic.data.summary : ch.blurb}

  og={`/og/${ogKey}.png`}
>
  {topic ? <TopicPage topic={topic} /> : <ChapterPage id={chapter!} />}
</Base>
