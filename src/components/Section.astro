---
interface Props {
  n: number;
  id: string;
  title: string;
}
const { n, id, title } = Astro.props;
---

<section id={id} class="scroll-mt-28 pt-12" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`} class="section-title mb-4">
    <span class="num">{String(n).padStart(2, '0')}</span>
    {title}
  </h2>
  <slot />
</section>
